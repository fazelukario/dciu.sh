# dciu.conf - Configuration for Docker Container Image Updater (dciu)
#
# Values: settings that are on or off take 'true' or 'false' ('yes'/'no' and '1'/'0' work too), in any case.
# An invalid value in this file is reported once per run, its default is used and the run ends with exit code 1.
# Most settings can be set per container with a label (LABEL_* below), which overrides this file; an invalid label
# value fails that container's update check (check_failed) and dciu leaves the container alone.

# Default Mode: autoupdate, monitor or none
MODE='monitor'

# Behavior for stopped containers: whether to update stopped containers or not
UPDATE_STOPPED='false'
# After updating stopped containers, whether to start them or not
START_STOPPED='false'

# Remove dangling images after updates
PRUNE_DANGLING='false'

# Update containers in docker compose stacks
UPDATE_COMPOSE='false'

# Docker Compose: what to recreate after pulling the new image of a service
#   'service' (default): only that service ('up --no-deps --force-recreate <service>'), its depends_on services are left alone
#   'stack': every service of the project ('up --force-recreate'), all of them started when the updated container was
#            running (or START_STOPPED='true'); the other containers of the project are recreated too, so with several
#            pending updates in one project dciu updates one per run
COMPOSE_RECREATE='service'
# Rebuild services that have a build: section when recreating them ('up --build'): 'false' (default) or 'true'
# COMPOSE_RECREATE='stack' with COMPOSE_BUILD='true' is the behaviour before dciu.sh 2.4.0
COMPOSE_BUILD='false'

# A registry can re-publish a tag (new index digest) without changing the image for this platform, e.g. a multi-arch
# image where only another platform was rebuilt or attestations were added.
#   'true' (default): after the pull dciu compares the pulled image with the running one (same layers and config =
#                     identical) and leaves the container alone (update_skipped); later checks treat it as up to
#                     date. Monitor mode never pulls, so it keeps reporting such a re-publish until the image is pulled.
#   'false': every pull is followed by a recreate (Watchtower's behaviour)
SKIP_IDENTICAL_IMAGES='true'

# Images in private repositories: 'true' looks them up with your credentials (GITHUB_TOKEN for ghcr.io, the login of
# 'docker login' for the other registries), 'false' (default). Per container: LABEL_PRIVATE_REPO below
PRIVATE_REPO='false'

# Labels for selecting containers
LABEL_MODE='dciu.mode'
# Labels to override stopped containers behavior
LABEL_UPDATE_STOPPED='dciu.update-stopped'
LABEL_START_STOPPED='dciu.start-stopped'
# Label to override dangling image prune behavior per container
LABEL_PRUNE_DANGLING='dciu.prune-dangling'
# Label to override update container in docker compose stacks behavior per container
LABEL_UPDATE_COMPOSE='dciu.update-compose'
# Labels to override COMPOSE_RECREATE and COMPOSE_BUILD per container (for a whole stack: set them on each of its services)
LABEL_COMPOSE_RECREATE='dciu.compose-recreate'
LABEL_COMPOSE_BUILD='dciu.compose-build'
# Label to override SKIP_IDENTICAL_IMAGES per container (for a whole stack: set it on each of its services)
LABEL_SKIP_IDENTICAL_IMAGES='dciu.skip-identical-images'
# Label to tell dciu that container image in private repository
# NOTE: For images in Docker Hub's private repositories supported only those that use pure Manifest V2 format
# (e.g. "application/vnd.docker.distribution.manifest.v2+json")
# You can check if image supported by running the following command on the latest image and comparing the output:
# 1: docker inspect --format '{{index .RepoDigests 0}}' "$img" 2> /dev/null | awk -F'@' '{print $2}' | awk -F':' '{print $2}'
# 2: printf "%s" "$(docker manifest inspect "$img" 2> /dev/null)" | sha256sum | awk '{print substr($1, 1, 64)}'
# If the output of the commands is equal, then the image is supported by dciu
# ghcr.io private repositories are supported if you provide a GitHub token with read:packages scope
LABEL_PRIVATE_REPO='dciu.private-repo'

# Notify module name (script in notify/ directory)
NOTIFY_MODULE='discord,telegram'
# Notify events: comma- or space-separated list of events to notify on (e.g. 'update_available,updated', 'all' or 'none')
# Available events: update_available, updated, update_failed, update_skipped, check_failed
# (check_failed: the update check itself failed, e.g. registry unreachable, unknown tag or an image without registry digest)
# all: notify on all events
# none: do not notify on any event
NOTIFY_EVENT='update_available,updated,update_failed,check_failed'

# Source of the notification (e.g. 'myserver', 'myserver.local', 'myserver.example.com')
#NOTIFY_SOURCE='myserver'

# GitHub token with read:packages scope for private repositories
#GITHUB_TOKEN='ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX' # Update with actual token

# Optional registry authentication (uncomment if needed) [TODO: implement and test]
# REGISTRY_USER=''
# REGISTRY_PASSWORD=''

# Log file path
LOG_FILE="$SCRIPT_DIR/dciu.sh.log"

# Debug level (debug output goes to stderr):
# 0: off (default)
# 1: what dciu does and the key values (resolved labels, digests, notify module, HTTP status)
# 2: level 1 + notification payloads, API responses and the SMTP transcript (may include SMTP_PASSWORD!)
# 3: everything
#DEBUG='0'

# Which debug levels are also written to LOG_FILE (0-3); defaults to DEBUG
#LOG_LEVEL=''

# Secrets (tokens, webhook URLs, passwords) are shown as [hidden] in debug output and LOG_FILE.
# Set to 'true' to show them in clear text - careful, they will end up in LOG_FILE too
#OUTPUT_INSECURE='false'

# NO_TIMESTAMP: if set to 'true', dciu will not add timestamps to log messages
#NO_TIMESTAMP='false'

# Variables for notify modules must be exported to be available in the notify module scripts (e.g. prefixed with 'export')
#DISCORD_WEBHOOK_URL='https://discord.com/api/webhooks/some-numbers/some-letters' # Update with actual webhook URL
#DISCORD_AVATAR_URL='https://example.com/avatar.png'  # Update with actual avatar URL
#DISCORD_USERNAME='dciu.sh'

#TELEGRAM_BOT_APITOKEN='123456789:ABCxyz' # Update with actual bot token
#TELEGRAM_BOT_CHATID='123456789' # Update with actual chat ID
